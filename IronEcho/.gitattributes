* text=auto

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Protocol golden vectors: small binaries, kept in plain git so both test suites can read them anywhere.
*.bin binary

# Unreal binary assets: Git LFS + lockable. Before editing: git lfs lock <file>; after push: git lfs unlock <file>.
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable

# Art sources (Codex)
*.blend filter=lfs diff=lfs merge=lfs -text lockable
*.fbx filter=lfs diff=lfs merge=lfs -text lockable
*.glb filter=lfs diff=lfs merge=lfs -text lockable
*.psd filter=lfs diff=lfs merge=lfs -text lockable
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.task filter=lfs diff=lfs merge=lfs -text

# Report screenshots are small and should render on GitHub and travel in git bundles: plain git, not LFS.
Docs/Reports/**/*.png -filter -diff -merge -text binary
Docs/Reports/**/*.jpg -filter -diff -merge -text binary
